 2 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/apps/mobile/src/PushGate.tsx b/apps/mobile/src/PushGate.tsx
index 53d34a0..7e30f7f 100644
--- a/apps/mobile/src/PushGate.tsx
+++ b/apps/mobile/src/PushGate.tsx
@@ -33,0 +34,12 @@ export function PushGate() {
+  /**
+   * 🔴 إصلاح ٦ أكتوبر (بلاغُ خالد): مؤقّتُ الانتقال كان يُنظَّف بتنظيف الأثر — و`setPending(null)` قبله يعيد تشغيلَ
+   * الأثر نفسِه فيُلغى المؤقّتُ قبل أن ينتهي: **كلُّ ضغطةٍ فتحت التطبيقَ ولم تذهب لوجهتها.** المؤقّتُ الآن في مرجعٍ
+   * يعيش بعمر المكوِّن لا بعمر دورة الأثر.
+   */
+  const nav = useRef<ReturnType<typeof setTimeout> | null>(null);
+  useEffect(
+    () => () => {
+      if (nav.current) clearTimeout(nav.current);
+    },
+    [],
+  );
@@ -67 +79,3 @@ export function PushGate() {
-    const t = setTimeout(() => {
+    if (nav.current) clearTimeout(nav.current);
+    nav.current = setTimeout(() => {
+      nav.current = null;
@@ -73 +87 @@ export function PushGate() {
-    return () => clearTimeout(t);
+    return undefined;
diff --git a/apps/mobile/src/push.ts b/apps/mobile/src/push.ts
index 6b9e1bb..b12fb06 100644
--- a/apps/mobile/src/push.ts
+++ b/apps/mobile/src/push.ts
@@ -63,0 +64,6 @@ function askedBefore(): boolean {
+/**
+ * 🔴 إصلاح ٦ أكتوبر (بلاغُ خالد، S24): الشرطُ كان يستثني `status === "denied"` — وأندرويد لا يعرف «لم يُسأل»:
+ * قبل أوّل سؤالٍ يردّ `denied` مع `canAskAgain: true`، فلم تُعرض النافذةُ لأحد. **المرجعُ `canAskAgain` وحدَه**
+ * لا اسمُ الحالة. وللسبب نفسِه `undetermined` هنا معناها «السؤالُ ما زال ممكناً» (صفُّ الإعدادات يسأل مباشرةً)،
+ * و`denied` «رفضٌ نهائيّ» (لا طريقَ إلّا إعداداتُ النظام).
+ */
@@ -66 +72 @@ async function readPermission(ask: boolean | "user"): Promise<State> {
-  if (!p.granted && ask && p.canAskAgain && p.status !== "denied" && (ask === "user" || !askedBefore())) {
+  if (!p.granted && ask && p.canAskAgain && (ask === "user" || !askedBefore())) {
@@ -74 +80 @@ async function readPermission(ask: boolean | "user"): Promise<State> {
-  return p.granted ? "granted" : p.status === "undetermined" ? "undetermined" : "denied";
+  return p.granted ? "granted" : p.canAskAgain ? "undetermined" : "denied";
