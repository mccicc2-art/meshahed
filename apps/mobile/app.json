{
  "expo": {
    "name": "Loopz",
    "slug": "mesh",
    "version": "1.13.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "com.loopztv.app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#050505",
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.loopztv.app",
      "appleTeamId": "GZFYZ4FGW4",
      "associatedDomains": [
        "applinks:loopztv.com"
      ],
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.loopztv.app"
        ]
      }
    },
    "android": {
      "package": "com.loopztv.app",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "loopztv.com",
              "pathPrefix": "/show/"
            },
            {
              "scheme": "https",
              "host": "loopztv.com",
              "pathPrefix": "/movie/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        { "iosUrlScheme": "com.googleusercontent.apps.751080411743-kbpar9g9kil8k1sccd1qcapni7o0oh6c" }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/splash-blank.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Loopz uses your photos to set your profile picture and cover.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Loopz saves the photos you choose to your library.",
          "granularPermissions": []
        }
      ],
      "./plugins/withLoopzWidget",
      "./plugins/withNoMinify",
      "@bacons/apple-targets",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFD400",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBase": "https://loopztv.com",
      "supabaseUrl": "https://uvgmvrdrxzpudoldjxaa.supabase.co",
      "eas": {
        "projectId": "928fd255-8956-4e37-a5eb-69d687282bbf"
      },
      "supabasePublishableKey": "sb_publishable_lGgIjPJMAHFF0zo7xSh1Qw_un3QheUo"
    },
    "owner": "loopztvs-team",
    "updates": {
      "url": "https://u.expo.dev/928fd255-8956-4e37-a5eb-69d687282bbf",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}