<?xml version="1.0" encoding="utf-8"?>
<!-- 🆕 خطّةُ الودجتات — RemoteViews: لا WebView ولا Compose. الألوانُ رموزُ الثيم الرسميّ (W2: الأسودُ دائماً) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="13dp">

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/tm_img"
            android:layout_width="82dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@drawable/widget_poster_ph" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/hdr_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFD400"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAlignment="viewStart" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/tm_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F7F7F7"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
            <TextView
                android:id="@+id/tm_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#B5B5B5"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
            <TextView
                android:id="@+id/tm_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFD400"
                android:textSize="11sp"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:visibility="gone" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/tm_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="#F7F7F7"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#B5B5B5"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
