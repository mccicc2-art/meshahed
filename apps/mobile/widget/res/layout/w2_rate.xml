<?xml version="1.0" encoding="utf-8"?>
<!-- W37 — شريطُ «قيّم الفيلم» بعد ✓ (٨٠، `rateStrip`): ملصقٌ صغيرٌ واسمٌ و«تخطَّ»، وعشرُ نجومٍ كالتطبيق — يبقى حتى يقيّم أو يتخطّى -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="@drawable/w2_panel"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/rt_img"
            android:layout_width="22dp"
            android:layout_height="33dp"
            android:scaleType="fitXY" />
        <TextView
    android:id="@+id/rt_title"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:textColor="#F7F7F7"
    android:textSize="13sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart"
    android:layout_weight="1"
    android:layout_marginStart="8dp" />
        <FrameLayout
    android:id="@+id/rt_skip"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_marginStart="8dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">
    <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="30dp"
    android:layout_gravity="center_vertical"
    android:background="@drawable/w2_chip"
    android:gravity="center_vertical"
    android:paddingStart="11dp"
    android:paddingEnd="11dp"
    android:orientation="horizontal">
    <TextView
        android:id="@+id/rt_skip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F7F7F7"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
</FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/rt_stars"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/rs_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_star_off" />
        <ImageView
            android:id="@+id/rs_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_star_off" />
        <ImageView
            android:id="@+id/rs_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_star_off" />
        <ImageView
            android:id="@+id/rs_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_star_off" />
        <ImageView
            android:id="@+id/rs_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_star_off" />
        <ImageView
            android:id="@+id/rs_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_star_off" />
        <ImageView
            android:id="@+id/rs_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_star_off" />
        <ImageView
            android:id="@+id/rs_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_star_off" />
        <ImageView
            android:id="@+id/rs_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_star_off" />
        <ImageView
            android:id="@+id/rs_10"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_star_off" />
    </LinearLayout>
</LinearLayout>
