<?xml version="1.0" encoding="utf-8"?>
<!-- W34 — فيلم الليلة «بوستر وتفاصيل»: بوسترٌ ٢:٣ كامل، والاسمُ والتقييمُ والمدّة، والرقاقتان -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tn_root"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/tn_img"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:scaleType="fitXY" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:orientation="vertical">
        <TextView
    android:id="@+id/tn_label"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="#FFD400"
    android:textSize="10.5sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart" />
        <TextView
    android:id="@+id/tn_name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="#F7F7F7"
    android:textSize="14sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart"
    android:layout_marginTop="6dp" />
        <TextView
    android:id="@+id/tn_sub"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="#B5B5B5"
    android:textSize="11sp"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart"
    android:layout_marginTop="3dp" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
    android:id="@+id/tn_check"
    android:layout_width="wrap_content"
    android:layout_height="26dp"
    android:background="@drawable/w2_chip"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/tn_check_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/widget_ic_check"
        android:tint="#F7F7F7" />
    <TextView
        android:id="@+id/tn_check_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:textColor="#F7F7F7"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
            <LinearLayout
    android:id="@+id/tn_another"
    android:layout_width="wrap_content"
    android:layout_height="26dp"
    android:layout_marginStart="6dp"
    android:background="@drawable/w2_chip"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/tn_another_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/widget_ic_repeat"
        android:tint="#F7F7F7" />
    <TextView
        android:id="@+id/tn_another_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:textColor="#F7F7F7"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
