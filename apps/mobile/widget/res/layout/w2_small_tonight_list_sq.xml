<?xml version="1.0" encoding="utf-8"?>
<!-- W46 — فيلم الليلة الصغير «قائمة» (أندرويد هـ) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView
    android:id="@+id/tl_label"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="#F7F7F7"
    android:textSize="14.5sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="96dp">
            <ImageView
                android:id="@+id/tl_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />
            <TextView
                android:id="@+id/tl_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="@drawable/w2_chip"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textColor="#FFD400"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:orientation="vertical">
            <FrameLayout
                android:id="@+id/tl_another"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <ImageView
                    android:id="@+id/tl_another_v"
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/w2_chip_round"
                    android:padding="8dp"
                    android:src="@drawable/widget_ic_repeat"
                    android:tint="#F7F7F7" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="5dp" />
            <FrameLayout
                android:id="@+id/tl_check"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <ImageView
                    android:id="@+id/tl_check_v"
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/w2_chip_round"
                    android:padding="9dp"
                    android:src="@drawable/widget_ic_check"
                    android:tint="#F7F7F7" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
    android:id="@+id/tl_runtime"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="#B5B5B5"
    android:textSize="11sp"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart" />
            <TextView
    android:id="@+id/tl_genre"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="#8A8A8A"
    android:textSize="10sp"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart"
    android:layout_marginTop="2dp" />
            <TextView
    android:id="@+id/tl_year"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="#8A8A8A"
    android:textSize="10sp"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart"
    android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/tl_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#F7F7F7"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart" />
</LinearLayout>
