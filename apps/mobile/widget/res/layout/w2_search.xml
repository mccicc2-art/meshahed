<?xml version="1.0" encoding="utf-8"?>
<!-- W31 — شريطُ البحث (لمستُه تفتح البحث: لا كتابةَ في ودجت)، و«الرائج اليوم» تحته في الشكل الكامل: قائمةٌ مرقّمةٌ بعمودين أو بوستراتٌ مرقّمةٌ ٢:٣ بلا مطّ (W38) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/w2_bar"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/widget_ic_search"
            android:tint="#FFD400" />
        <TextView
    android:id="@+id/bar_text"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:textColor="#B5B5B5"
    android:textSize="12sp"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart"
    android:layout_weight="1"
    android:layout_marginStart="10dp" />
    </LinearLayout>
    <TextView
    android:id="@+id/trend_title"
    android:layout_width="match_parent"
    android:layout_height="16dp"
    android:textColor="#B5B5B5"
    android:textSize="11sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart"
    android:layout_marginTop="8dp"
    android:visibility="gone" />
    <LinearLayout
        android:id="@+id/trend_list"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">
    <LinearLayout
        android:id="@+id/tl_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tl_rank_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD400"
            android:textSize="15sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/tl_img_1"
            android:layout_width="28dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:scaleType="fitXY" />
        <TextView
    android:id="@+id/tl_name_1"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:textColor="#F7F7F7"
    android:textSize="11sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart"
    android:layout_weight="1"
    android:layout_marginStart="8dp" />
    </LinearLayout>
<LinearLayout
        android:id="@+id/tl_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tl_rank_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B5B5B5"
            android:textSize="15sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/tl_img_2"
            android:layout_width="28dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:scaleType="fitXY" />
        <TextView
    android:id="@+id/tl_name_2"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:textColor="#F7F7F7"
    android:textSize="11sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart"
    android:layout_weight="1"
    android:layout_marginStart="8dp" />
    </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/trend_posters"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">
    <FrameLayout
        android:id="@+id/tp_1"
        android:layout_width="87dp"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/tp_img_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <TextView
            android:id="@+id/tp_rank_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="7dp"
            android:layout_marginBottom="3dp"
            android:textColor="#FFD400"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
<FrameLayout
        android:id="@+id/tp_2"
        android:layout_width="87dp"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/tp_img_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <TextView
            android:id="@+id/tp_rank_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="7dp"
            android:layout_marginBottom="3dp"
            android:textColor="#F7F7F7"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
<FrameLayout
        android:id="@+id/tp_3"
        android:layout_width="87dp"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/tp_img_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <TextView
            android:id="@+id/tp_rank_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="7dp"
            android:layout_marginBottom="3dp"
            android:textColor="#F7F7F7"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>
    </LinearLayout>
</LinearLayout>
