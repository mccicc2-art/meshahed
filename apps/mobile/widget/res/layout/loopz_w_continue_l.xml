<?xml version="1.0" encoding="utf-8"?>
<!-- 🆕 خطّةُ الودجتات — RemoteViews: لا WebView ولا Compose. الألوانُ رموزُ الثيم الرسميّ (W2: الأسودُ دائماً) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="13dp">

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="9dp">
            <TextView
                android:id="@+id/hdr_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFD400"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
            <TextView
                android:id="@+id/hdr_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="#B5B5B5"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/slot_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            >
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="62dp">
                <ImageView
                    android:id="@+id/img_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/widget_poster_ph" />
                <TextView
                    android:id="@+id/plus_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_slot_empty"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#B5B5B5"
                    android:textSize="18sp"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/check_1"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/widget_check"
                    android:padding="6dp"
                    android:src="@drawable/widget_ic_check"
                    android:tint="#F7F7F7"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView
                android:id="@+id/name_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#F7F7F7"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
            <TextView
                android:id="@+id/sub_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B5B5B5"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/slot_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="62dp">
                <ImageView
                    android:id="@+id/img_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/widget_poster_ph" />
                <TextView
                    android:id="@+id/plus_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_slot_empty"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#B5B5B5"
                    android:textSize="18sp"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/check_2"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/widget_check"
                    android:padding="6dp"
                    android:src="@drawable/widget_ic_check"
                    android:tint="#F7F7F7"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView
                android:id="@+id/name_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#F7F7F7"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
            <TextView
                android:id="@+id/sub_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B5B5B5"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/slot_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="62dp">
                <ImageView
                    android:id="@+id/img_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/widget_poster_ph" />
                <TextView
                    android:id="@+id/plus_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_slot_empty"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#B5B5B5"
                    android:textSize="18sp"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/check_3"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/widget_check"
                    android:padding="6dp"
                    android:src="@drawable/widget_ic_check"
                    android:tint="#F7F7F7"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView
                android:id="@+id/name_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#F7F7F7"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
            <TextView
                android:id="@+id/sub_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B5B5B5"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
        </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="11dp"
            android:background="#14FFFFFF" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/up_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFD400"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAlignment="viewStart" />
            <TextView
                android:id="@+id/up_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="#B5B5B5"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/up_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            >
            <ImageView
                android:id="@+id/up_img_1"
                android:layout_width="28dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:background="@drawable/widget_poster_ph" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/up_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#F7F7F7"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
                <TextView
                    android:id="@+id/up_sub_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B5B5B5"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
            </LinearLayout>
            <TextView
                android:id="@+id/up_chip_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#B5B5B5"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/up_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="9dp">
            <ImageView
                android:id="@+id/up_img_2"
                android:layout_width="28dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:background="@drawable/widget_poster_ph" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/up_name_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#F7F7F7"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
                <TextView
                    android:id="@+id/up_sub_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B5B5B5"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
            </LinearLayout>
            <TextView
                android:id="@+id/up_chip_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#B5B5B5"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/up_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="9dp">
            <ImageView
                android:id="@+id/up_img_3"
                android:layout_width="28dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:background="@drawable/widget_poster_ph" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/up_name_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#F7F7F7"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
                <TextView
                    android:id="@+id/up_sub_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B5B5B5"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
            </LinearLayout>
            <TextView
                android:id="@+id/up_chip_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#B5B5B5"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>
        <TextView
            android:id="@+id/up_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#B5B5B5"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#B5B5B5"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
