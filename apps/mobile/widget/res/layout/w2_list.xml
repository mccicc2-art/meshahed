                    android:textSize="9.5sp"
                    android:maxLines="1" />
            </LinearLayout>
            <TextView
                android:id="@+id/lp_sub_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#D6D6D6"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
