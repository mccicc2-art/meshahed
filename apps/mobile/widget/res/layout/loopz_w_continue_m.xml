<?xml version="1.0" encoding="utf-8"?>
<!-- 🆕 W19 — المتوسط: بطاقتان كبطاقة «أكمل المشاهدة» في الرئيسيّة (الصورةُ والحجابُ والشريطُ مرسومةٌ في كوتلن بمقاس الخانة)، وتحتهما سطرُ «القادم» -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingTop="11dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/hdr_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/widget_ic_play"
                android:tint="#FFD400" />
            <TextView
                android:id="@+id/hdr_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F7F7F7"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
            <TextView
                android:id="@+id/hdr_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#A8A8A8"
                android:textSize="11sp"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/card_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="9dp">
            <ImageView
                android:id="@+id/card_img_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />
            <TextView
                android:id="@+id/card_plus_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_slot_empty"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="#B5B5B5"
                android:textSize="11sp"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/card_check_1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_margin="7dp"
                android:background="@drawable/widget_check"
                android:padding="7dp"
                android:src="@drawable/widget_ic_check"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/card_text_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/card_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/card_sub_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#BFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAlignment="viewStart" />
                    <TextView
                        android:id="@+id/card_pct_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/card_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/card_img_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />
            <TextView
                android:id="@+id/card_plus_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_slot_empty"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="#B5B5B5"
                android:textSize="11sp"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/card_check_2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_margin="7dp"
                android:background="@drawable/widget_check"
                android:padding="7dp"
                android:src="@drawable/widget_ic_check"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/card_text_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/card_name_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewStart" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/card_sub_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#BFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAlignment="viewStart" />
                    <TextView
                        android:id="@+id/card_pct_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/up_rule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:background="#17FFFFFF" />
        <LinearLayout
            android:id="@+id/up_line"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/up_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="#FFD400"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:maxLines="1" />
            <ImageView
                android:id="@+id/up_img"
                android:layout_width="15dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:scaleType="fitXY" />
            <TextView
                android:id="@+id/up_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="#F7F7F7"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/up_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#A8A8A8"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#B5B5B5"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
