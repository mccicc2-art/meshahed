<?xml version="1.0" encoding="utf-8"?>
<!-- W34 · W42 — فيلم الليلة كاملاً: هيدرٌ ١٦:٩ بعرض الودجت، و«✓ شاهدته» و«🔁 فيلم آخر» على الصورة في طرفها -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tn_root"
    android:layout_width="match_parent"
    android:layout_height="188dp">
    <ImageView
        android:id="@+id/tn_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />
    <TextView
    android:id="@+id/tn_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textColor="#FFD400"
    android:textSize="10.5sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart"
    android:layout_gravity="top|start"
    android:layout_marginStart="11dp"
    android:layout_marginTop="9dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        android:paddingStart="11dp"
        android:paddingEnd="9dp"
        android:paddingBottom="9dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
    android:id="@+id/tn_name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="#F7F7F7"
    android:textSize="14sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart" />
            <TextView
    android:id="@+id/tn_sub"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="#D6D6D6"
    android:textSize="11sp"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAlignment="viewStart" />
        </LinearLayout>
        <FrameLayout
    android:id="@+id/tn_check"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_marginStart="6dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">
    <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="30dp"
    android:layout_gravity="center_vertical"
    android:background="@drawable/w2_chip"
    android:gravity="center_vertical"
    android:paddingStart="11dp"
    android:paddingEnd="11dp"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/tn_check_icon"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:src="@drawable/widget_ic_check"
        android:tint="#F7F7F7" />
    <TextView
        android:id="@+id/tn_check_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:textColor="#F7F7F7"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
</FrameLayout>
        <FrameLayout
    android:id="@+id/tn_another"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_marginStart="6dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">
    <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="30dp"
    android:layout_gravity="center_vertical"
    android:background="@drawable/w2_chip"
    android:gravity="center_vertical"
    android:paddingStart="11dp"
    android:paddingEnd="11dp"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/tn_another_icon"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:src="@drawable/widget_ic_repeat"
        android:tint="#F7F7F7" />
    <TextView
        android:id="@+id/tn_another_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:textColor="#F7F7F7"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
</FrameLayout>
    </LinearLayout>
</FrameLayout>
