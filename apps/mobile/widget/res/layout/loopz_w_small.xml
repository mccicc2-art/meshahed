<?xml version="1.0" encoding="utf-8"?>
<!-- 🆕 خطّةُ الودجتات W21 — الصغيرُ بالملصق كبطاقة «To watch»: الملصقُ كلُّه بمقاس الودجت (الصورةُ تُرسم بمقاسه في
     كوتلن ومعها التظليلُ فوق وتحت، فـ`fitXY` هنا لا يمطّ شيئاً)، والاسمُ على الحافة السفلى والسطرُ الثاني فوقه -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <ImageView
        android:id="@+id/full_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />
    <FrameLayout
        android:id="@+id/full_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_scrim" />
    <TextView
        android:id="@+id/full_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="40dp"
        android:textColor="#FFD400"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1" />
    <ImageView
        android:id="@+id/full_action"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="7dp"
        android:background="@drawable/widget_check"
        android:padding="6dp"
        android:visibility="gone" />
    <!-- 🆕 W34 · W43 — ✓ في الطرف السفليّ (فيلم الليلة الصغير، وأكمل المشاهدة الطوليّ) بالرقاقة الرماديّة نفسِها -->
    <ImageView
        android:id="@+id/full_check"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:background="@drawable/w2_chip_round"
        android:padding="7dp"
        android:src="@drawable/widget_ic_check"
        android:tint="#F7F7F7"
        android:visibility="gone" />
    <TextView
        android:id="@+id/full_plus"
        android:layout_width="46dp"
        android:layout_height="62dp"
        android:layout_gravity="center"
        android:layout_marginBottom="14dp"
        android:background="@drawable/widget_slot_empty"
        android:gravity="center"
        android:text="+"
        android:textColor="#B5B5B5"
        android:textSize="18sp"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="10dp"
        android:paddingEnd="44dp"
        android:paddingBottom="9dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/full_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:textColor="#D6D6D6"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAlignment="viewStart" />
        <TextView
            android:id="@+id/full_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F7F7F7"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAlignment="viewStart" />
    </LinearLayout>
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#B5B5B5"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
