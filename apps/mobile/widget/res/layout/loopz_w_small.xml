<?xml version="1.0" encoding="utf-8"?>
<!-- 🆕 خطّةُ الودجتات — الصغير: ملصقٌ كاملٌ وحجابٌ يجعل الحرفَ الأبيضَ مقروءاً فوق أيِّ صورة -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <ImageView
        android:id="@+id/full_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />
    <View
        android:id="@+id/full_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_scrim" />
    <TextView
        android:id="@+id/full_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="11dp"
        android:textColor="#FFD400"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1" />
    <ImageView
        android:id="@+id/full_action"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/widget_check"
        android:padding="8dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/full_plus"
        android:layout_width="46dp"
        android:layout_height="62dp"
        android:layout_gravity="center"
        android:layout_marginBottom="14dp"
        android:background="@drawable/widget_slot_empty"
        android:gravity="center"
        android:text="+"
        android:textColor="#B5B5B5"
        android:textSize="18sp"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/full_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F7F7F7"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAlignment="viewStart" />
        <TextView
            android:id="@+id/full_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#DDDDDD"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAlignment="viewStart" />
    </LinearLayout>
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#B5B5B5"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
