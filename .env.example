# === Supabase ===
# من لوحة تحكم Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhb....your-anon-key

# === TMDB ===
# من موقع themoviedb.org: Settings > API > API Key (v3 auth)
TMDB_API_KEY=your_tmdb_v3_api_key

# === Site URL ===
# رابط الموقع (محلياً http://localhost:3000 ، وعلى Vercel رابط المشروع)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trakt — لاستيراد المكتبة من trakt.tv (اختياري).
# أنشئ تطبيقاً في https://trakt.tv/oauth/applications واجعل
# Redirect URI = https://<نطاقك>/api/trakt/callback
# بدونهما يختفي زرّ الربط من الإعدادات ولا ينكسر شيء.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Gemini — بحث الوصف الحرّ «وضع الذكاء» (اختياري).
# المفتاح من https://aistudio.google.com/apikey — بدونه يختفي الوضع ولا ينكسر شيء.
GEMINI_API_KEY=
# النموذج قابل للتبديل؛ يُترك فارغاً ليستخدم الافتراضي في الكود
GEMINI_MODEL=
